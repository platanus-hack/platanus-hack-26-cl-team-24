      "html": "<p class=\"ds-plate ds-allow\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7\"/></svg>Entregado</p><p class=\"ds-plate ds-repair\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 20h4L19 9l-4-4L4 16z\"/><path d=\"M13 7l4 4\"/></svg>Reparado</p><p class=\"ds-plate ds-review\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4.5 21a7.5 7.5 0 0 1 15 0\"/></svg>Revisión humana</p>",
      "css": ".ds-plate{font-family:Inter,system-ui,sans-serif;display:flex;align-items:center;gap:.8rem;margin:0 0 .8rem;padding:.85rem 1.2rem;border-radius:.9rem;font-size:2.1rem;font-weight:800;letter-spacing:-.025em;color:var(--deep,#0e1022);animation:ds-wipe .7s cubic-bezier(.16,1,.3,1)}.ds-plate svg{width:1.2em;height:1.2em;fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:2.8}.ds-allow{background:var(--ok,#3ddc97)}.ds-repair{background:var(--warn,#ffc145)}.ds-review{background:var(--bad,#ff5d6c)}@keyframes ds-wipe{from{clip-path:inset(0 100% 0 0 round .9rem)}to{clip-path:inset(0 0 0 0 round .9rem)}}@media (prefers-reduced-motion:reduce){.ds-plate{animation:none}}"
    }
